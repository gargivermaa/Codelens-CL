# Copy to .env and fill in. Never commit .env or the .pem key.

# --- Required: shared secret configured on the GitHub webhook / GitHub App ---
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- GitHub App (preferred): App ID and path to its private key ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github_app.pem
# Optional fallback for local demos without an App: a fine-grained personal
# access token with Pull requests: read & write, Contents: read.
GITHUB_TOKEN=
# false = compute and store reviews but do not post them to GitHub
GITHUB_POST_REVIEWS=true

# --- Local infrastructure (docker compose overrides these with service names) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codelens
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# Optional: embedded Qdrant at a path instead of a server (single process only)
QDRANT_PATH=

# --- Gemini API, FREE TIER ONLY (https://aistudio.google.com/apikey). Do not enable billing. ---
# Free-tier content may be used by Google to improve its products: index and
# review only public / non-confidential repositories.
GEMINI_API_KEY=
GEMINI_REVIEW_MODEL=gemini-2.5-flash
EMBEDDING_QUERY_TASK_TYPE=CODE_RETRIEVAL_QUERY
GEMINI_MIN_REQUEST_INTERVAL_S=1.0
GEMINI_MAX_ATTEMPTS=5

# --- Review limits ---
REVIEW_TOP_K=5
REVIEW_MAX_FILES=30
REVIEW_MAX_PATCH_LINES=2000
REVIEW_MAX_INLINE_COMMENTS=15

# --- Optional LangSmith tracing (free developer tier) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codelens-ci

# --- Logging: text | json ---
LOG_FORMAT=text
LOG_LEVEL=INFO
